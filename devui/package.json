{
	"name": "@portalvr/devui",
	"version": "1.1.2",
	"description": "Developer UI for PortalVR",
	"type": "module",
	"main": "lib/index.js",
	"types": "lib/index.d.ts",
	"files": [
		"build",
		"lib",
		"assets"
	],
	"scripts": {
		"prebuild": "node -p \"'export const VERSION = ' + JSON.stringify(require('./package.json').version) + ';'\" > src/version.ts",
		"build": "node ./scripts/generate-assets.mjs && tsc && node ./scripts/copy-static-assets.mjs && rollup -c"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/portalvr/portalvr-webxr.git"
	},
	"keywords": [],
	"author": "Portal VR, Inc. <team@portalvr.io>",
	"license": "MIT",
	"bugs": {
		"url": "https://portalvr.io/support"
	},
	"homepage": "https://portalvr.io",
	"dependencies": {
		"@yume-chan/adb": "^2.3.1",
		"@yume-chan/adb-daemon-webusb": "^2.1.0",
		"qrcode-generator": "^2.0.4",
		"react": "^18.2.0",
		"react-dom": "^18.2.0"
	},
	"peerDependencies": {
		"portalvr": "^2.0.1"
	},
	"devDependencies": {
		"@rollup/plugin-commonjs": "^28.0.1",
		"@rollup/plugin-node-resolve": "^15.3.0",
		"@rollup/plugin-replace": "^6.0.1",
		"@rollup/plugin-terser": "^0.4.4",
		"@types/react": "^18.2.39",
		"@types/react-dom": "^18.2.17",
		"portalvr": "file:../",
		"rollup": "^4.24.3",
		"rollup-plugin-peer-deps-external": "^2.2.4",
		"typescript": "^5.6.3"
	}
}
