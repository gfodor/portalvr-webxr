{
	"name": "PortalVR for WebXR",
	"short_name": "PortalVR WebXR",
	"version": "2.0.2",
	"minimum_chrome_version": "96",
	"description": "Play WebXR experiences on your laptop using your phone as a fully tracked controller—no headset required.",
	"author": "Portal VR, Inc. (support@portalvr.io)",
	"homepage_url": "https://portalvr.io/",
	"icons": {
		"16": "icons/portalvr16.png",
		"32": "icons/portalvr32.png",
		"48": "icons/portalvr48.png",
		"128": "icons/portalvr128.png",
		"512": "icons/portalvr512.png"
	},
	"background": {
		"service_worker": "build/service-worker.min.js"
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["build/content-loader.js"],
			"run_at": "document_start",
			"all_frames": true
		}
	],
	"permissions": ["storage", "scripting", "webNavigation"],
	"host_permissions": ["http://*/*", "https://*/*"],
	"action": {
		"default_title": "PortalVR for WebXR",
		"default_icon": {
			"16": "icons/portalvr16.png",
			"32": "icons/portalvr32.png",
			"48": "icons/portalvr48.png",
			"128": "icons/portalvr128.png"
		}
	},
	"manifest_version": 3,
	"web_accessible_resources": [
		{
			"resources": [
				"build/iwe.min.js",
				"build/identity-bootstrap.js",
				"build/wasm/portal-pose/portal_pose.wasm"
			],
			"matches": ["<all_urls>"]
		},
		{
			"resources": ["build/runtime/*"],
			"matches": ["<all_urls>"]
		}
	],
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self'"
	}
}
