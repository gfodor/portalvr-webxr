{
	"name": "Immersive Web Emulator",
	"short_name": "IWE",
	"version": "2.0.0",
	"minimum_chrome_version": "96",
	"description": "WebXR Emulator for Meta Quest devices",
	"author": "Felix Zhang (fe1ix@meta.com)",
	"icons": {
		"16": "icons/default16.png",
		"48": "icons/default48.png",
		"128": "icons/default128.png"
	},
	"background": {
		"service_worker": "build/service-worker.min.js"
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["build/content-loader.js"],
			"run_at": "document_start",
			"all_frames": true
		}
	],
	"permissions": ["storage", "scripting", "webNavigation"],
	"host_permissions": ["http://*/*", "https://*/*"],
	"action": {
		"default_icon": {
			"16": "icons/default16.png",
			"48": "icons/default48.png",
			"128": "icons/default128.png"
		}
	},
	"manifest_version": 3,
	"web_accessible_resources": [
		{
			"resources": [
				"build/iwe.min.js",
				"build/wasm/portal-pose/portal_pose.wasm"
			],
			"matches": ["<all_urls>"]
		},
		{
			"resources": ["build/runtime/*"],
			"matches": ["<all_urls>"]
		}
	],
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self'"
	}
}
